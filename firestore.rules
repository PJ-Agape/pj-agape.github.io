rules_version = '2';

// Reglas de seguridad de la Pastoral Juvenil Ágape.
// Pégalas en Firebase → Firestore Database → Reglas → Publicar.
// El correo de bootstrapAdmin() es el primer administrador (el mismo de bootstrapAdmins en js/config.js).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function myEmail() { return request.auth.token.email.lower(); }
    function bootstrapAdmin() { return signedIn() && myEmail() in ['iperezconus84@gmail.com']; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isMember() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && me().active == true;
    }
    function isAdmin() { return isMember() && me().role == 'admin'; }
    // Equipo: administradores y coordinadores (Agenda, Portada y moderación de muro y chat).
    function isStaff() { return isMember() && me().role in ['admin', 'coordinador']; }
    // Guías: quienes acompañan a los jóvenes (equipo y dirigentes).
    function isGuide() { return isMember() && me().role in ['admin', 'coordinador', 'dirigente']; }
    function validRole(r) { return r in ['admin', 'coordinador', 'dirigente', 'aspirante', 'ingreso', 'madurez']; }
    // Cuentas protegidas: siempre administradoras y activas.
    function protectedEmail(e) { return e in ['iperezconus84@gmail.com']; }

    // Contenido del curso publicado desde Gestión: lo lee cualquiera, lo escribe un administrador.
    match /content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Portada de Inicio: también la editan los coordinadores.
    match /content/portada {
      allow write: if isStaff();
    }
    // Cuadro de honor y desafío de la semana: los publica el equipo. Cumpleaños: los actualizan los guías.
    match /content/honor { allow write: if isStaff(); }
    match /content/desafio { allow write: if isStaff(); }
    match /content/cumples { allow write: if isGuide(); }
    // Datos que no deben ser públicos (cumpleaños): solo cuentas activas; los actualizan los guías.
    match /privado/{docId} {
      allow read: if isMember();
      allow write: if isGuide();
    }
    // Página para familias: la editan administradores y coordinadores.
    match /content/familias { allow write: if isStaff(); }
    // Apariencia de la app (fondos, stickers, textos y colores) y la foto de fondo de cada zona.
    match /content/apariencia { allow write: if isStaff(); }
    match /content/{fondo} { allow write: if isStaff() && fondo.matches('^fondo_[a-z]{2,20}$'); }

    // Invitaciones: el documento se llama como el correo invitado (en minúsculas).
    match /invites/{email} {
      allow get: if signedIn() && myEmail() == email;
      allow read, delete: if isAdmin();
      // Jóvenes: no se puede invitar sin registrar el consentimiento de su familia (o que es mayor de edad).
      allow create, update: if isAdmin() && validRole(request.resource.data.role)
        && (!(request.resource.data.role in ['ingreso', 'madurez', 'aspirante'])
            || (request.resource.data.consent is map
                && (request.resource.data.consent.get('mayor', false) == true || request.resource.data.consent.get('fecha', '') is string && request.resource.data.consent.get('fecha', '').size() == 10)));
    }

    // Solicitudes de cuenta (Inicio → «Solicitar mi cuenta»): quien entra con Google sin invitación deja
    // su nombre, edad, parroquia o capilla y los datos de su ficha privada (que su familia revisa en el
    // consentimiento). Solo la ven esa persona y los administradores, que la aprueban.
    match /solicitudes/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, delete: if isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'edad', 'parish', 'createdAt', 'nacimiento', 'rut', 'direccion', 'emergNombre', 'emergTel', 'alergias', 'notas'])
        && request.resource.data.uid == uid
        && request.resource.data.email == myEmail()
        && validText(request.resource.data.name, 80)
        && request.resource.data.edad is int && request.resource.data.edad >= 8 && request.resource.data.edad <= 99
        && request.resource.data.parish is string && request.resource.data.parish.size() > 0 && request.resource.data.parish.size() <= 120
        && request.resource.data.get('nacimiento', '').size() <= 10 && request.resource.data.get('rut', '').size() <= 15
        && request.resource.data.get('direccion', '').size() <= 160 && request.resource.data.get('emergNombre', '').size() <= 80
        && request.resource.data.get('emergTel', '').size() <= 40 && request.resource.data.get('alergias', '').size() <= 500
        && request.resource.data.get('notas', '').size() <= 1000;
    }

    // Cuentas. Cada persona crea la suya al entrar por primera vez, solo si fue invitada
    // (con el rol de la invitación) o si es administrador inicial.
    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      // Administradores: todo. Coordinadores: directorio para armar salas (el avance sigue siendo solo de administradores).
      allow read: if isStaff();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.email == myEmail()
        && request.resource.data.active == true
        && (
          (exists(/databases/$(database)/documents/invites/$(myEmail()))
            && request.resource.data.role == get(/databases/$(database)/documents/invites/$(myEmail())).data.role)
          || (bootstrapAdmin() && request.resource.data.role == 'admin')
        );
      // Cada uno puede actualizar su nombre, parroquia y última conexión; nunca su rol ni su estado.
      allow update: if (isMember() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'parish', 'lastSeen', 'avatar'])
          && (!('avatar' in request.resource.data) || (request.resource.data.avatar is string && request.resource.data.avatar.size() <= 20)))
        || (isAdmin() && validRole(request.resource.data.role)
            && (!protectedEmail(resource.data.email) || (request.resource.data.role == 'admin' && request.resource.data.active == true)));
      allow delete: if isAdmin() && !protectedEmail(resource.data.email);
    }

    // Avance en los cursos: lo escribe su dueño; lo leen su dueño y los administradores.
    match /progress/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow write: if isMember() && request.auth.uid == uid;
    }

    // Cuaderno personal: privado, solo su dueño (ni siquiera los administradores lo leen).
    match /notes/{uid} {
      allow read, write: if isMember() && request.auth.uid == uid;
    }

    // Constancias: cualquiera puede verificar un código; solo el dueño la registra; un administrador puede anularla.
    match /certificates/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isMember() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Muro de la comunidad. Lo visible lo lee cualquiera; escriben los usuarios invitados;
    // los administradores publican anuncios y temas, fijan, cierran, ocultan y borran.
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function onlyMyKey(field) {
      return request.resource.data[field] is map
        && request.resource.data[field].diff(resource.data[field]).affectedKeys().hasOnly([request.auth.uid]);
    }
    function markUpdate() {
      return (changed().hasOnly(['likes']) && onlyMyKey('likes'))
        || (changed().hasOnly(['reports']) && onlyMyKey('reports'));
    }
    function asAuthor(d) {
      return d.authorUid == request.auth.uid && d.authorRole == me().role
        && d.authorName is string && d.authorName.size() > 0 && d.authorName.size() <= 60
        && d.hidden == false && d.likes.size() == 0 && d.reports.size() == 0 && d.createdAt == request.time;
    }
    function validText(t, max) { return t is string && t.size() > 0 && t.size() <= max; }

    // El muro lo leen solo quienes tienen cuenta (los jóvenes escriben ahí).
    match /wall/{postId} {
      allow read: if isMember() && (resource.data.hidden == false || isStaff());
      allow create: if isMember() && asAuthor(request.resource.data)
        && validText(request.resource.data.title, 140) && request.resource.data.body is string && request.resource.data.body.size() <= 4000
        && request.resource.data.type in ['anuncio', 'tema', 'pregunta', 'logro', 'encuesta']
        && (request.resource.data.type != 'encuesta' || (request.resource.data.options is list
            && request.resource.data.options.size() >= 2 && request.resource.data.options.size() <= 6 && request.resource.data.votes.size() == 0))
        && (isStaff() || (request.resource.data.type == 'pregunta' && request.resource.data.pinned == false)
          // Felicitación automática: solo por una constancia propia, una por constancia.
          || (request.resource.data.type == 'logro' && request.resource.data.pinned == false
              && request.resource.data.certCode is string && postId == 'logro-' + request.resource.data.certCode
              && get(/databases/$(database)/documents/certificates/$(request.resource.data.certCode)).data.uid == request.auth.uid))
        && request.resource.data.closed == false && request.resource.data.replyCount == 0
        && request.resource.data.lastActivity == request.time;
      allow update: if isStaff()
        || (isMember() && resource.data.hidden == false && (
          markUpdate()
          // votar en una encuesta: cada uno su propio voto, mientras esté abierta
          || (resource.data.type == 'encuesta' && resource.data.closed == false && changed().hasOnly(['votes'])
              && request.resource.data.votes.diff(resource.data.votes).affectedKeys().hasOnly([request.auth.uid])
              && (!(request.auth.uid in request.resource.data.votes)
                  || (request.resource.data.votes[request.auth.uid] is int && request.resource.data.votes[request.auth.uid] >= 0
                      && request.resource.data.votes[request.auth.uid] < resource.data.options.size())))
          // al responder o borrar una respuesta se actualiza el contador
          || (changed().hasOnly(['replyCount', 'lastActivity'])
              && (request.resource.data.replyCount - resource.data.replyCount) in [1, -1]
              && (request.resource.data.lastActivity == resource.data.lastActivity || request.resource.data.lastActivity == request.time))
          || (resource.data.authorUid == request.auth.uid && changed().hasOnly(['title', 'body', 'editedAt'])
              && validText(request.resource.data.title, 140) && request.resource.data.body.size() <= 4000)
        ));
      allow delete: if isStaff() || (isMember() && resource.data.authorUid == request.auth.uid);

      match /replies/{replyId} {
        function post() { return get(/databases/$(database)/documents/wall/$(postId)).data; }
        allow read: if isMember() && ((resource.data.hidden == false && post().hidden == false) || isStaff());
        allow create: if isMember() && asAuthor(request.resource.data) && validText(request.resource.data.body, 2000)
          && post().hidden == false && post().closed == false && post().type != 'anuncio';
        allow update: if isStaff()
          || (isMember() && resource.data.hidden == false && (
            markUpdate()
            || (resource.data.authorUid == request.auth.uid && changed().hasOnly(['body', 'editedAt'])
                && validText(request.resource.data.body, 2000))
          ));
        // la borra su autor, un administrador o el autor del tema (al borrar su tema completo)
        allow delete: if isStaff() || (isMember() && (resource.data.authorUid == request.auth.uid || post().authorUid == request.auth.uid));
      }
    }


    // Chat por salas: todas grupales. Leen y escriben solo los integrantes de cada sala.
    // Cuatro salas fijas (la general es de todos) y las que crea el equipo en «salas».
    // Administradores y coordinadores están en todas y moderan.
    function builtIn(sala) { return sala in ['general', 'coordinacion', 'dirigentes', 'aspirantes']; }
    function salaDoc(sala) { return get(/databases/$(database)/documents/salas/$(sala)).data; }
    function inCustom(sala) {
      return exists(/databases/$(database)/documents/salas/$(sala)) && (isStaff()
        || salaDoc(sala).access == 'all'
        || (salaDoc(sala).access == 'roles' && me().role in salaDoc(sala).roles)
        || (salaDoc(sala).access == 'people' && request.auth.uid in salaDoc(sala).members));
    }
    function inSala(sala) {
      return isMember() && (builtIn(sala)
        ? (sala == 'general' || isStaff() || sala in me().get('salas', me().role == 'aspirante' ? ['aspirantes'] : (me().role in ['ingreso', 'madurez'] ? [] : ['dirigentes'])))
        : inCustom(sala));
    }
    function openSala(sala) { return builtIn(sala) || salaDoc(sala).get('archived', false) != true; }

    // Salas creadas por el equipo: las ven quienes tienen cuenta; las crean y editan administradores y coordinadores.
    match /salas/{salaId} {
      allow read: if isMember();
      allow create, update: if isStaff() && !builtIn(salaId)
        && validText(request.resource.data.name, 60)
        && request.resource.data.access in ['all', 'roles', 'people']
        && request.resource.data.roles is list && request.resource.data.members is list
        && (request.resource.data.access != 'roles' || request.resource.data.roles.size() > 0)
        && (request.resource.data.access != 'people' || request.resource.data.members.size() >= 3);
      allow delete: if isStaff();
    }
    match /chat/{sala}/msgs/{msgId} {
      allow read: if inSala(sala);
      allow create: if inSala(sala) && openSala(sala)
        && request.resource.data.authorUid == request.auth.uid && request.resource.data.authorRole == me().role
        && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 60
        && validText(request.resource.data.text, 1500)
        && request.resource.data.reports.size() == 0 && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(['text', 'authorUid', 'authorName', 'authorRole', 'authorAvatar', 'reports', 'reactions', 'replyTo', 'kind', 'buzzTo', 'buzzToName', 'createdAt'])
        && (!('authorAvatar' in request.resource.data) || (request.resource.data.authorAvatar is string && request.resource.data.authorAvatar.size() <= 20))
        && (!('reactions' in request.resource.data) || request.resource.data.reactions.size() == 0)
        && (!('replyTo' in request.resource.data) || (request.resource.data.replyTo is map && request.resource.data.replyTo.keys().hasOnly(['id', 'name', 'text'])))
        && (!('kind' in request.resource.data) || (request.resource.data.kind == 'buzz' && request.resource.data.buzzTo is string));
      // Reportar o reaccionar: cada uno cambia solo su propia marca.
      allow update: if inSala(sala) && (
        (changed().hasOnly(['reports']) && onlyMyKey('reports'))
        || (changed().hasOnly(['reactions']) && request.resource.data.reactions is map
            && ('reactions' in resource.data
                ? request.resource.data.reactions.diff(resource.data.reactions).affectedKeys().hasOnly([request.auth.uid])
                : request.resource.data.reactions.keys().hasOnly([request.auth.uid]))
            && (!(request.auth.uid in request.resource.data.reactions)
                || request.resource.data.reactions[request.auth.uid] in ['❤️', '🙏', '😂', '👍', '😮', '🔥'])));
      allow delete: if isStaff() || (inSala(sala) && resource.data.authorUid == request.auth.uid);
    }


    // Velas de la capilla: intenciones que solo ve la comunidad con cuenta.
    // Cada uno enciende la suya; todos pueden marcar «rezo por esto»; la apaga su autor o el equipo.
    // Cumpleaños que cada persona comparte desde «Mi cuenta» (solo día y mes, con nombre corto).
    // Lo ven quienes tienen cuenta; cada uno guarda o quita solo el suyo. Los jóvenes menores
    // solo pueden compartirlo si su familia lo autorizó en el consentimiento (consent.cumple).
    function puedeMostrarCumple() {
      return !(me().role in ['ingreso', 'madurez', 'aspirante'])
        || me().get('consent', {}).get('mayor', false) == true
        || me().get('consent', {}).get('cumple', false) == true;
    }
    match /cumpleanos/{uid} {
      allow read: if isMember();
      allow create, update: if isMember() && request.auth.uid == uid && puedeMostrarCumple()
        && request.resource.data.keys().hasOnly(['n', 'md', 'at'])
        && request.resource.data.n is string && request.resource.data.n.size() > 0 && request.resource.data.n.size() <= 40
        && request.resource.data.md is string && request.resource.data.md.matches('^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && request.resource.data.at == request.time;
      allow delete: if (isMember() && request.auth.uid == uid) || isStaff();
    }

    // Momentos: fotos con descripción que suben coordinadores y administradores (la imagen va
    // comprimida dentro del documento). Quienes tienen cuenta reaccionan (una reacción cada uno)
    // y comentan; cada uno borra sus comentarios y el equipo modera.
    match /momentos/{mid} {
      allow read: if isMember();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['img', 'texto', 'authorUid', 'authorName', 'authorAvatar', 'reacts', 'commentCount', 'createdAt'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.img is string && request.resource.data.img.size() > 100 && request.resource.data.img.size() <= 900000
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 1000
        && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 60
        && request.resource.data.reacts.size() == 0 && request.resource.data.commentCount == 0
        && request.resource.data.createdAt == request.time;
      allow update: if (isStaff() && changed().hasOnly(['texto', 'editedAt'])
          && request.resource.data.texto is string && request.resource.data.texto.size() <= 1000)
        || (isMember() && changed().hasOnly(['reacts']) && onlyMyKey('reacts')
          && (!(request.auth.uid in request.resource.data.reacts)
              || request.resource.data.reacts[request.auth.uid] in ['amen', 'corazon', 'alegria', 'fuerza']))
        || (isMember() && changed().hasOnly(['commentCount'])
          && (request.resource.data.commentCount - resource.data.commentCount) in [1, -1]);
      allow delete: if isStaff();

      match /comentarios/{cid} {
        allow read: if isMember();
        allow create: if isMember()
          && request.resource.data.keys().hasOnly(['texto', 'authorUid', 'authorName', 'authorAvatar', 'createdAt'])
          && request.resource.data.authorUid == request.auth.uid
          && validText(request.resource.data.texto, 500)
          && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 60
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/momentos/$(mid));
        allow delete: if isStaff() || (isMember() && resource.data.authorUid == request.auth.uid);
      }
    }

    match /velas/{velaId} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['text', 'authorUid', 'authorName', 'prays', 'createdAt'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 1500
        && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 60
        && request.resource.data.prays.size() == 0 && request.resource.data.createdAt == request.time;
      allow update: if isMember() && changed().hasOnly(['prays']) && onlyMyKey('prays');
      allow delete: if isStaff() || (isMember() && resource.data.authorUid == request.auth.uid);
    }

    // Cursos de la comunidad (Gestión → Cursos de la comunidad): un curso completo por documento, como JSON.
    // Los lee cualquiera (como el contenido del curso). Los crean, corrigen, publican y borran los
    // administradores y quienes un administrador marca como formadores (users.formador).
    function canCourses() { return isAdmin() || (isMember() && me().get('formador', false) == true); }
    match /cursos/{cursoId} {
      allow read: if true;
      allow create, update: if canCourses()
        && request.resource.data.json is string && request.resource.data.json.size() > 0 && request.resource.data.json.size() <= 900000
        && validText(request.resource.data.title, 120) && request.resource.data.hidden is bool;
      allow delete: if canCourses();
    }

    // Avisos del equipo: la coordinación (administradores y coordinadores) envía avisos o tareas a dirigentes y coordinadores.
    // Cada destinatario solo puede marcar su propio «Recibido» o «Listo». No hay respuestas: lo conversado va por WhatsApp.
    match /avisos/{id} {
      allow read: if isStaff() || (isGuide() && request.auth.uid in resource.data.to);
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['kind', 'title', 'text', 'due', 'to', 'toNames', 'by', 'byName', 'acks', 'createdAt'])
        && request.resource.data.kind in ['aviso', 'tarea'] && validText(request.resource.data.title, 120)
        && request.resource.data.text is string && request.resource.data.text.size() <= 2000
        && request.resource.data.to is list && request.resource.data.to.size() >= 1 && request.resource.data.to.size() <= 100
        && request.resource.data.by == request.auth.uid && request.resource.data.acks.size() == 0
        && request.resource.data.createdAt == request.time;
      allow update: if isGuide() && request.auth.uid in resource.data.to
        && changed().hasOnly(['acks']) && onlyMyKey('acks');
      allow delete: if isStaff();
    }

    // Cancionero: lo ve la comunidad con cuenta (uso interno). Lo editan el equipo y quienes un
    // administrador habilita para el apostolado del cancionero (users.cantor); borrar es solo del equipo.
    function canSongs() { return isStaff() || (isMember() && me().get('cantor', false) == true); }
    match /canciones/{songId} {
      allow read: if isMember();
      allow create, update: if canSongs() && validText(request.resource.data.title, 120)
        && request.resource.data.body is string && request.resource.data.body.size() <= 20000;
      allow delete: if isStaff();
    }
    match /repertorios/{repId} {
      allow read: if isMember();
      allow create, update: if canSongs() && validText(request.resource.data.name, 120);
      allow delete: if isStaff();
    }

    // Quién está en línea en cada sala (cada uno escribe solo su propia presencia).
    match /chat/{sala}/presence/{uid} {
      allow read: if inSala(sala);
      allow create, update: if inSala(sala)
        && uid == request.auth.uid && request.resource.data.at == request.time
        && request.resource.data.keys().hasOnly(['name', 'avatar', 'role', 'at']);
      allow delete: if (signedIn() && uid == request.auth.uid) || isStaff();
    }

    // Banco de dinámicas: lo ve la comunidad con cuenta; lo alimentan los guías.
    match /dinamicas/{id} {
      allow read: if isMember();
      allow create, update: if isGuide() && validText(request.resource.data.title, 80)
        && request.resource.data.pasos is string && request.resource.data.pasos.size() <= 4000;
      allow delete: if isStaff() || (isGuide() && resource.data.authorUid == request.auth.uid);
    }

    // Acompañamiento: lista de jóvenes y asistencia. Solo los guías; cada joven con cuenta ve su pasaporte
    // y puede cambiar su lema, el color de portada y su avatar. Vincular cuentas es del equipo.
    match /jovenes/{id} {
      allow read: if isGuide() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isGuide() && validText(request.resource.data.nombre, 80)
        && request.resource.data.etapa in ['ingreso', 'madurez', 'aspirante', 'equipo']
        && (isStaff() || request.resource.data.get('uid', '') == '');
      allow update: if (isGuide() && validText(request.resource.data.nombre, 80)
          && request.resource.data.etapa in ['ingreso', 'madurez', 'aspirante', 'equipo']
          && (isStaff() || request.resource.data.get('uid', '') == resource.data.get('uid', ''))
          && (isStaff() || !changed().hasAny(['guia', 'guia2', 'guiaNombre', 'guia2Nombre'])))
        || (signedIn() && resource.data.uid == request.auth.uid && changed().hasOnly(['lema', 'portada', 'avatar'])
          && request.resource.data.get('lema', '') is string && request.resource.data.get('lema', '').size() <= 60);
      allow delete: if isStaff();
    }
    // Ficha privada de cada joven (fichas/{id en la lista de jóvenes}): RUT, edad, dirección, contacto de
    // emergencia, alergias y lo que la familia quiera informar. Nunca se publica. La ven y editan el equipo
    // (administradores y coordinadores), los dirigentes que lo acompañan (a cargo o de apoyo) y el propio joven.
    match /fichas/{jid} {
      function fj() { return get(/databases/$(database)/documents/jovenes/$(jid)).data; }
      function puedeFicha() {
        return isStaff() || (isGuide() && request.auth.uid in [fj().get('guia', ''), fj().get('guia2', '')])
          || (isMember() && fj().get('uid', '') == request.auth.uid);
      }
      allow read: if puedeFicha();
      allow create, update: if puedeFicha()
        && request.resource.data.keys().hasOnly(['jid', 'nombre', 'rut', 'nacimiento', 'direccion', 'email', 'emergNombre', 'emergTel', 'alergias', 'notas', 'updatedAt', 'updatedBy'])
        && request.resource.data.jid == jid && request.resource.data.updatedAt == request.time
        && request.resource.data.get('nombre', '') is string && request.resource.data.get('nombre', '').size() <= 100
        && request.resource.data.get('rut', '') is string && request.resource.data.get('rut', '').size() <= 15
        && request.resource.data.get('nacimiento', '') is string && request.resource.data.get('nacimiento', '').size() <= 10
        && request.resource.data.get('direccion', '') is string && request.resource.data.get('direccion', '').size() <= 160
        && request.resource.data.get('email', '') is string && request.resource.data.get('email', '').size() <= 120
        && request.resource.data.get('emergNombre', '') is string && request.resource.data.get('emergNombre', '').size() <= 80
        && request.resource.data.get('emergTel', '') is string && request.resource.data.get('emergTel', '').size() <= 40
        && request.resource.data.get('alergias', '') is string && request.resource.data.get('alergias', '').size() <= 500
        && request.resource.data.get('notas', '') is string && request.resource.data.get('notas', '').size() <= 1000;
      allow delete: if isStaff();
    }
    match /sesiones/{fecha} {
      allow read, create, update: if isGuide();
      allow delete: if isStaff();
    }

    // Desafío de la semana: cada uno marca que lo cumplió.
    match /desafios/{key}/hechos/{uid} {
      allow read: if isMember();
      allow create, update: if isMember() && uid == request.auth.uid && request.resource.data.keys().hasOnly(['n', 'a', 'at']);
      allow delete: if isMember() && uid == request.auth.uid;
    }

    // Contador de visitas anónimo: una visita por dispositivo y día (v total, c con cuenta, g visitantes).
    // Cualquiera suma 1; solo el equipo lo lee. No guarda datos personales.
    // Nuestras familias: 10 grupos pequeños (f1..f10). Los ven quienes tienen cuenta.
    // El equipo arma cada familia; sus integrantes y dirigentes (uids) solo pueden cambiarle el nombre.
    match /familias/{fid} {
      allow read: if isMember();
      allow create, update: if isStaff() && fid.matches('^f([1-9]|10)$')
        && request.resource.data.get('nombre', '') is string && request.resource.data.get('nombre', '').size() <= 40;
      allow update: if isMember() && request.auth.uid in resource.data.get('uids', [])
        && changed().hasOnly(['nombre', 'nombrePor', 'icono', 'updatedAt'])
        && validText(request.resource.data.get('nombre', 'x'), 40)
        && request.resource.data.get('icono', '') is string && request.resource.data.get('icono', '').size() <= 40;
      allow delete: if isStaff();

      // Mini portal de la familia: muro y agenda propios. Solo sus integrantes, sus dirigentes y el equipo.
      function famDoc() { return get(/databases/$(database)/documents/familias/$(fid)).data; }
      function inFam() { return isMember() && request.auth.uid in famDoc().get('uids', []); }
      function famMod() { return isStaff() || (inFam() && isGuide()); }
      match /muro/{pid} {
        allow read: if inFam() || isStaff();
        allow create: if inFam() && request.resource.data.autorUid == request.auth.uid
          && validText(request.resource.data.texto, 500)
          && request.resource.data.autorNombre is string && request.resource.data.autorNombre.size() <= 60
          && request.resource.data.likes.size() == 0 && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly(['texto', 'autorUid', 'autorNombre', 'autorAvatar', 'likes', 'createdAt']);
        allow update: if (inFam() || isStaff()) && changed().hasOnly(['likes']) && onlyMyKey('likes');
        allow delete: if famMod() || (inFam() && resource.data.autorUid == request.auth.uid);
      }
      match /agenda/{eid} {
        allow read: if inFam() || isStaff();
        allow create, update: if famMod() && validText(request.resource.data.titulo, 80)
          && request.resource.data.fecha is string && request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.get('lugar', '').size() <= 80 && request.resource.data.get('nota', '').size() <= 300
          && request.resource.data.porUid == request.auth.uid;
        allow delete: if famMod();
      }
      // Evaluación de cada encuentro: 5 respuestas sí/no y un comentario de hasta 150 caracteres.
      // Cada integrante escribe la suya ({año}-{n}-{uid}); la familia la ven sus dirigentes y el equipo.
      match /evals/{eid} {
        allow read: if famMod() || (signedIn() && resource.data.uid == request.auth.uid);
        allow create, update: if inFam() && request.resource.data.uid == request.auth.uid
          && eid == string(request.resource.data.year) + '-' + string(request.resource.data.n) + '-' + request.auth.uid
          && request.resource.data.keys().hasOnly(['n', 'year', 'r', 'c', 'uid', 'at'])
          && request.resource.data.n is int && request.resource.data.year is int
          && request.resource.data.r is list && request.resource.data.r.size() == 5
          && request.resource.data.c is string && request.resource.data.c.size() <= 150
          && request.resource.data.at == request.time;
        allow delete: if isStaff();
      }
    }
    // Rosarios por la intención del Papa: contador público por mes; quienes tienen cuenta suman de a uno.
    match /rosarios/{mes} {
      allow read: if true;
      allow create: if isMember() && mes.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if isMember() && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n == resource.data.n + 1;
    }
    // «Quiero conocer Ágape» (#/conocer): cualquiera, sin cuenta, deja un contacto para que lo inviten.
    // Nadie de afuera puede leer la lista: solo el equipo. Los menores de 18 dejan el contacto de un adulto.
    match /interesados/{id} {
      allow create: if request.resource.data.keys().hasOnly(['quien', 'nombre', 'hijo', 'edad', 'telefono', 'adultoNombre', 'adultoTel', 'adultoSabe', 'origen', 'campana', 'mensaje', 'consiente', 'estado', 'createdAt'])
        && request.resource.data.quien in ['joven', 'familia']
        && validText(request.resource.data.nombre, 80)
        && request.resource.data.get('hijo', '') is string && request.resource.data.get('hijo', '').size() <= 80
        && request.resource.data.edad is int && request.resource.data.edad >= 10 && request.resource.data.edad <= 35
        && request.resource.data.telefono is string && request.resource.data.telefono.size() <= 20
        && request.resource.data.get('adultoNombre', '') is string && request.resource.data.get('adultoNombre', '').size() <= 80
        && request.resource.data.get('adultoTel', '') is string && request.resource.data.get('adultoTel', '').size() <= 20
        && (request.resource.data.quien == 'familia' || request.resource.data.edad >= 18
            ? request.resource.data.telefono.size() >= 8
            : (request.resource.data.get('adultoSabe', false) == true && request.resource.data.get('adultoNombre', '').size() > 0 && request.resource.data.get('adultoTel', '').size() >= 8))
        && request.resource.data.origen in ['amigo', 'parroquia', 'colegio', 'catequesis', 'instagram', 'tiktok', 'facebook', 'whatsapp', 'afiche', 'otro']
        && request.resource.data.campana is string && request.resource.data.campana.size() <= 30
        && request.resource.data.mensaje is string && request.resource.data.mensaje.size() <= 300
        && request.resource.data.consiente == true
        && request.resource.data.estado == 'nuevo'
        && request.resource.data.createdAt == request.time;
      allow read: if isStaff();
      allow update: if isStaff() && changed().hasOnly(['estado', 'atendidoPor', 'atendidoEn'])
        && request.resource.data.estado in ['nuevo', 'contactado', 'vino', 'no'];
      allow delete: if isAdmin();
    }

    // Lo más visto (vistas/AAAA-MM-DD): cada escritura suma 1 a una sola sección de la lista.
    // La lista debe coincidir con VISTAS de js/cloud.js.
    function vistaOk(antes, despues) {
      let cambio = despues.diff(antes).affectedKeys();
      return despues.keys().hasOnly(['inicio', 'evangelio', 'capilla', 'rosario', 'rato', 'intenciones', 'radio',
          'salmos', 'oremus', 'cancionero', 'comunidad', 'muro', 'chat', 'momentos', 'juegos', 'podcast', 'agenda',
          'formacion', 'curso', 'materiales', 'dinamicas', 'difusion', 'ayuda', 'buscar'])
        && cambio.size() == 1
        && despues[cambio.toList()[0]] == antes.get(cambio.toList()[0], 0) + 1;
    }
    match /vistas/{day} {
      allow read: if isStaff();
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && vistaOk({}, request.resource.data);
      allow update: if vistaOk(resource.data, request.resource.data);
    }

    match /stats/{day} {
      allow read: if isStaff();
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['v', 'c', 'g'])
        && request.resource.data.get('v', 0) == 1
        && request.resource.data.get('c', 0) + request.resource.data.get('g', 0) == 1;
      allow update: if request.resource.data.keys().hasOnly(['v', 'c', 'g'])
        && request.resource.data.get('v', 0) == resource.data.get('v', 0) + 1
        && request.resource.data.get('c', 0) >= resource.data.get('c', 0)
        && request.resource.data.get('g', 0) >= resource.data.get('g', 0)
        && request.resource.data.get('c', 0) + request.resource.data.get('g', 0) == resource.data.get('c', 0) + resource.data.get('g', 0) + 1;
    }

    // Programación del mes (Agenda): notas sin fecha y tablero Pendiente / En curso / Realizado.
    // Solo los guías (equipo y dirigentes) la ven y la editan.
    match /programa/{pid} {
      allow read, delete: if isGuide();
      allow create, update: if isGuide()
        && request.resource.data.mes is string && request.resource.data.mes.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.tipo in ['nota', 'tarea']
        && request.resource.data.t is string && request.resource.data.t.size() > 0 && request.resource.data.t.size() <= 300
        && request.resource.data.get('est', 'pend') in ['pend', 'curso', 'hecho']
        && request.resource.data.get('resp', '').size() <= 60
        && request.resource.data.get('ev', '').size() <= 600
        && request.resource.data.get('por', '').size() <= 80;
    }

    // Agenda oficial: la ve cualquiera (familias incluidas); la editan los administradores.
    match /agenda/{eventId} {
      allow read: if true;
      allow write: if isStaff();
      // Confirmaciones de asistencia de las familias (página para familias, sin cuenta), solo en
      // actividades con «Invitar a las familias». Las ven los guías y las borra el equipo.
      match /confirmaciones/{cid} {
        allow read: if isGuide();
        allow create: if get(/databases/$(database)/documents/agenda/$(eventId)).data.get('invFam', false) == true
          && request.resource.data.keys().hasOnly(['joven', 'personas', 'fecha', 'createdAt'])
          && request.resource.data.joven is string && request.resource.data.joven.size() >= 2 && request.resource.data.joven.size() <= 60
          && request.resource.data.personas is int && request.resource.data.personas >= 1 && request.resource.data.personas <= 5
          && request.resource.data.fecha is string && request.resource.data.fecha.size() == 10
          && request.resource.data.createdAt == request.time;
        allow delete: if isStaff();
      }
    }

    // Juegos en línea («¡Última!»): una sala por código de 4 letras. La ven quienes tienen cuenta.
    // Quien está en la sala puede escribir la partida; los demás solo pueden sumarse mientras espera.
    match /partidas/{pid} {
      function partidaKeys() { return ['game', 'host', 'status', 'players', 'g', 'said', 'pen', 'at', 'createdAt']; }
      allow read: if isMember();
      allow create: if isMember() && pid.matches('^[A-Z]{4}$')
        && request.resource.data.keys().hasOnly(partidaKeys())
        && request.resource.data.game == 'ultima'
        && request.resource.data.host == request.auth.uid
        && request.resource.data.status == 'lobby'
        && request.resource.data.players is map
        && request.resource.data.players.keys().hasOnly([request.auth.uid])
        && request.resource.data.createdAt == request.time;
      allow update: if isMember()
        && request.resource.data.keys().hasOnly(partidaKeys())
        && request.resource.data.game == resource.data.game
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.players is map
        && request.resource.data.players.size() <= 8
        && request.resource.data.status in ['lobby', 'play', 'end']
        && (request.auth.uid in resource.data.players
          || (resource.data.status == 'lobby' && changed().hasOnly(['players', 'at'])
            && onlyMyKey('players') && request.auth.uid in request.resource.data.players));
      allow delete: if isMember() && (resource.data.host == request.auth.uid || isStaff()
        || resource.data.at < request.time - duration.value(12, 'h'));
    }

    // Moderación: los administradores revisan todas las respuestas del muro.
    match /{path=**}/replies/{replyId} {
      allow read: if isStaff();
    }
  }
}
